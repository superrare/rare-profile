{
  "name": "rare-profile",
  "version": "0.1.0-beta.1",
  "description": "Wallet-less CLI + SDK for managing a rare.xyz profile",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "rare-profile": "dist/bin.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rolldown -c rolldown.config.ts && cp dist/index.d.ts dist/index.d.cts && chmod +x dist/bin.js && mkdir -p dist/skills && cp skills/rare-profile-cli.md dist/skills/",
    "test:unit": "node --import tsx/esm --test 'test/*.test.ts'",
    "test:integration": "pnpm build && node --import tsx/esm --test 'test/integration/**/*.test.ts'",
    "test:e2e": "pnpm build && node --import tsx/esm --test 'test/e2e/**/*.test.ts'",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:e2e",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rolldown": "latest",
    "rolldown-plugin-dts": "^0.25.2",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0"
  }
}
