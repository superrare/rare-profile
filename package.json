{
  "name": "rare-profile",
  "version": "0.0.0",
  "description": "Wallet-less CLI + SDK for managing a rare.xyz profile",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "rare-profile": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rolldown -c rolldown.config.ts && chmod +x dist/bin.js",
    "test": "node --import tsx/esm --test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rolldown": "latest",
    "rolldown-plugin-dts": "^0.25.2",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0"
  }
}
